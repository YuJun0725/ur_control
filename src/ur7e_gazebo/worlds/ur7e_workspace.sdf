<?xml version="1.0"?>
<sdf version="1.10">
  <!-- ros_gz_sim's set_entity_pose helper targets /world/default/set_pose. -->
  <world name="default">
    <physics name="bullet_featherstone_1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- DART does not implement SDFormat mimic constraints in Harmonic.
         Bullet Featherstone does, which is required for the five passive
         Robotiq joints to follow the commanded master knuckle physically. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 0.02</size></box></geometry>
          <material><diffuse>0.32 0.34 0.38 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <model name="workspace_table">
      <static>true</static>
      <pose>0 0.48 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.45 0.30</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.45 0.30</size></box></geometry>
          <material><diffuse>0.45 0.25 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workspace_back_wall">
      <static>true</static>
      <pose>0 0.75 0.575 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.05 0.55</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.05 0.55</size></box></geometry>
          <material><diffuse>0.60 0.66 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workspace_storage_box">
      <static>true</static>
      <pose>-0.26 0.62 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.14 0.14 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 0.14 0.20</size></box></geometry>
          <material><diffuse>0.10 0.38 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workspace_center_divider">
      <static>true</static>
      <pose>0.02 0.47 0.42 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.06 0.18 0.24</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.18 0.24</size></box></geometry>
          <material><diffuse>0.95 0.48 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workspace_target">
      <pose>0.16 0.47 0.331 0 0 0</pose>
      <allow_auto_disable>false</allow_auto_disable>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0000321667</ixx><iyy>0.0000321667</iyy><izz>0.0000163333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.035 0.035 0.060</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.035 0.035 0.060</size></box></geometry>
          <material><diffuse>0.88 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
